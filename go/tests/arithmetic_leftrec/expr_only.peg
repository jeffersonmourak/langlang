// Expr as the entry rule, for the left-recursive-entry differential test.
Expr <- Expr¹ '||' Expr²
      / Expr² '&&' Expr³
      / Expr³ '==' Expr⁴
      / Expr³ '!=' Expr⁴
      / Expr⁴ '<=' Expr⁵
      / Expr⁴ '>=' Expr⁵
      / Expr⁴ '<' Expr⁵
      / Expr⁴ '>' Expr⁵
      / Expr⁵ '+' Expr⁶
      / Expr⁵ '-' Expr⁶
      / Expr⁶ '*' Expr⁷
      / Expr⁶ '/' Expr⁷
      / Expr⁶ '%' Expr⁷
      / '-' Expr⁷
      / '(' Expr¹ ')'^closeparen
      / Number
      / Identifier

Number     <- #([1-9][0-9]* / '0')
Identifier <- !Keywords #([a-zA-Z_][a-zA-Z0-9_]*)
Keywords   <- 'let' / 'if'

// Recovery expressions
leteq      <- (!Expr .)*
letexpr    <- (!';' .)*
letsemi    <-
iflpar     <- (!Expr .)*
ifexpr     <- (!(')' / '{') .)*
ifrpar     <- (!('{') .)*
ifrcurl    <-
exprsemi   <-
closeparen <- (!(';' / '}' / EOF) .)*

